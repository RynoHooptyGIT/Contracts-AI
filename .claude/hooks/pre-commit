#!/bin/bash
#
# Pre-commit hook for Contracts-AI Documentation Agent
# Automatically validates and generates documentation before commits
#
# Installation:
#   cp .claude/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -e

echo ""
echo "📚 Documentation Agent - Pre-Commit Check"
echo "=========================================="
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "${YELLOW}⚠️  No files staged for commit${NC}"
    exit 0
fi

echo "${BLUE}📋 Analyzing staged files...${NC}"
echo ""

# Initialize counters
FRONTEND_FILES=0
BACKEND_FILES=0
DOC_FILES=0
NEEDS_DOCS=0

# Categorize files
while IFS= read -r file; do
    if [[ $file == frontend/src/* ]]; then
        ((FRONTEND_FILES++))
        echo "  • Frontend: $file"
    elif [[ $file == backend/* ]]; then
        ((BACKEND_FILES++))
        echo "  • Backend: $file"
    elif [[ $file == docs/* ]] || [[ $file == *.md ]]; then
        ((DOC_FILES++))
        echo "  • Documentation: $file"
    fi
done <<< "$STAGED_FILES"

echo ""
echo "${BLUE}📊 Summary:${NC}"
echo "  Frontend files: $FRONTEND_FILES"
echo "  Backend files: $BACKEND_FILES"
echo "  Documentation files: $DOC_FILES"
echo ""

# Check if code changes need documentation
if [ $FRONTEND_FILES -gt 0 ] || [ $BACKEND_FILES -gt 0 ]; then
    echo "${YELLOW}🔍 Checking documentation requirements...${NC}"
    echo ""

    # Check for CHANGELOG.md update
    if ! echo "$STAGED_FILES" | grep -q "CHANGELOG.md"; then
        echo "${YELLOW}⚠️  Warning: Code changes detected but CHANGELOG.md not updated${NC}"
        echo "   Consider documenting this change in CHANGELOG.md"
        echo ""
        ((NEEDS_DOCS++))
    fi

    # Check for feature documentation if frontend changed significantly
    if [ $FRONTEND_FILES -gt 0 ]; then
        # Check if App.jsx was modified (likely a feature change)
        if echo "$STAGED_FILES" | grep -q "frontend/src/App.jsx"; then
            echo "${BLUE}ℹ️  App.jsx modified - ensure feature documentation exists${NC}"
            echo "   Location: docs/features/"
            echo ""
        fi
    fi

    # Check for API documentation if backend changed
    if [ $BACKEND_FILES -gt 0 ]; then
        # Check if main.py was modified (likely an API change)
        if echo "$STAGED_FILES" | grep -q "backend/main.py"; then
            echo "${BLUE}ℹ️  main.py modified - ensure API documentation exists${NC}"
            echo "   Location: docs/api/"
            echo ""
        fi
    fi

    # If documentation is missing, provide guidance
    if [ $DOC_FILES -eq 0 ] && [ $NEEDS_DOCS -gt 0 ]; then
        echo "${YELLOW}📝 Documentation Recommendations:${NC}"
        echo ""
        echo "  1. Update CHANGELOG.md with your changes"
        echo "  2. Add feature docs in docs/features/ if adding new functionality"
        echo "  3. Update docs/api/ if modifying endpoints"
        echo "  4. Ensure code has appropriate comments"
        echo ""
        echo "${YELLOW}💡 Tip: You can commit now, but consider adding documentation${NC}"
        echo ""
    fi
fi

# Create docs directory structure if it doesn't exist
if [ ! -d "docs" ]; then
    echo "${BLUE}📁 Creating documentation directory structure...${NC}"
    mkdir -p docs/features
    mkdir -p docs/api
    mkdir -p docs/architecture
    mkdir -p docs/guides
    echo "  ✓ Documentation directories created"
    echo ""
fi

# Check for CHANGELOG.md existence
if [ ! -f "CHANGELOG.md" ]; then
    echo "${BLUE}📝 Creating CHANGELOG.md...${NC}"
    cat > CHANGELOG.md << 'EOF'
# Changelog

All notable changes to the Contracts-AI project will be documented in this file.

The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/),
and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).

## [Unreleased]

### Added
- Initial project setup with React frontend and FastAPI backend
- Ollama Mistral integration for chat functionality

### Changed

### Fixed

### Removed

EOF
    git add CHANGELOG.md
    echo "  ✓ CHANGELOG.md created and staged"
    echo ""
fi

# Final checks passed
echo "${GREEN}✅ Documentation checks completed${NC}"
echo ""
echo "📌 Remember to:"
echo "  • Add meaningful commit messages"
echo "  • Document complex logic with comments"
echo "  • Update CHANGELOG.md for notable changes"
echo ""

exit 0
