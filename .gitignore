# Contracts-AI .gitignore

# ============================================
# Python (Backend)
# ============================================

# Virtual Environment
backend/venv/
backend/env/
backend/ENV/
backend/.venv/
*.pyc
__pycache__/
*.py[cod]
*$py.class

# Python Distribution
*.egg-info/
dist/
build/
*.egg

# PyCharm
.idea/

# VS Code
.vscode/
*.code-workspace

# Jupyter Notebook
.ipynb_checkpoints

# Environment variables
.env
.env.local
.env.*.local

# ============================================
# Node.js / React (Frontend)
# ============================================

# Dependencies
frontend/node_modules/
node_modules/

# Build output
frontend/dist/
frontend/build/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
.nyc_output/

# ============================================
# Operating System
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================
# Claude Code
# ============================================

# Claude session files (keep agent definitions and hooks)
.claude/sessions/
.claude/plans/
.claude/.migrations/

# Keep these Claude files:
# .claude/agents/
# .claude/hooks/
# .claude/settings.local.json

# ============================================
# Logs
# ============================================

*.log
logs/
*.log.*

# ============================================
# Temporary Files
# ============================================

*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ============================================
# Sensitive Information
# ============================================

# API Keys and Secrets
secrets.json
credentials.json
*.pem
*.key

# Configuration files with secrets
config.local.*
settings.local.json

# ============================================
# Project Specific
# ============================================

# Ollama models (if storing locally - usually not needed)
# models/

# Chat history exports
exports/
*.chat.json

# Development artifacts
.scratch/
.tmp/
