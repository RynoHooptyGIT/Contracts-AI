# Backend Environment Configuration

# CORS Configuration
# Comma-separated list of allowed origins
# Development: http://localhost:5173
# Production: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Ollama Configuration
OLLAMA_URL=http://localhost:11434/api/chat

# Rate Limiting
# Format: requests/time_period (e.g., 20/minute)
RATE_LIMIT=20/minute

# Admin Authentication (Phase 1)
# Simple bearer token for admin endpoints
# IMPORTANT: Change this to a secure random token in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=your-secure-admin-token-here
